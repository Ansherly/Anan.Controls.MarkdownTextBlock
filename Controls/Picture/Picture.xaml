<?xml version="1.0" encoding="utf-8" ?>

<UserControl x:Class="Anan.Controls.Picture"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Root"
             mc:Ignorable="d">

    <Grid>
        <Image x:Name="Viewer"
               Stretch="{x:Bind Stretch, Mode=OneWay}" />
        <!--
            加载占位:主题自适应底色 + 呼吸式透明度动画。
            刻意不引第三方控件 —— 包依赖越少,消费方的依赖树越干净。
        -->
        <Border x:Name="shimmer"
                Width="400"
                Height="240"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                CornerRadius="4"
                Opacity="0.5" />
        <Button x:Name="DisplayButton"
                Content="点击显示图片"
                Visibility="Collapsed"
                Click="DisplayButton_Click" />
    </Grid>
</UserControl>
