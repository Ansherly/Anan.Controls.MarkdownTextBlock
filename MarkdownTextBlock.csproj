<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      三个 TFM:WinUI 3 消费方大多还在 net8 / net9,只发 net10 的话他们在搜索列表里根本看不到本包
      (NuGet 会按目标框架过滤掉不兼容的包)。
    -->
    <TargetFrameworks>net8.0-windows10.0.19041.0;net9.0-windows10.0.19041.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <OutputType>Library</OutputType>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!--
      AOT / 裁剪兼容:
        · SkiaSharp 的 SKXamlCanvas 实现了泛型 WinRT 接口,需要 unsafe 代码(CsWinRT1030);
        · IsAotCompatible 会启用裁剪/AOT 分析器,保证库在 NativeAOT 下不静默失效。
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>

    <Platforms>x86;x64;ARM64</Platforms>

    <!--
      库必须以 AnyCPU 产出:否则 PlatformTarget 会跟随 $(Platform),
      把 DLL 的 PE Machine 打成 x64 / ARM64,包里那份就只对单一架构友好。
      IL 本身是架构无关的,AnyCPU 戳才能让 x86 / x64 / ARM64 消费方共用同一个包。
    -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>

    <AssemblyName>MarkdownTextBlock</AssemblyName>
    <RootNamespace>Anan.Controls.MarkdownTextBlock</RootNamespace>
  </PropertyGroup>

  <!-- ================= 包元数据 ================= -->
  <PropertyGroup>
    <PackageId>Anan.Controls.MarkdownTextBlock</PackageId>
    <Version>1.1.0</Version>
    <Authors>Ansherly</Authors>
    <Company>Ansherly</Company>
    <Copyright>Copyright (c) 2026 Ansherly</Copyright>
    <Description>WinUI 3 的 Markdown 渲染控件，提供Markdig 解析和策略化渲染,支持标题 / 段落 / 引用 / 列表 / 任务列表 / 表格 / 代码块/ 图片 / HTML 白名单 / LaTeX 公式。</Description>
    <PackageTags>winui;winui3;markdown;control;xaml;markdown-viewer;latex;codeblock;winappsdk</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/Ansherly/Anan.Controls.MarkdownTextBlock.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Ansherly/Anan.Controls.MarkdownTextBlock</PackageProjectUrl>
    <PackageReleaseNotes>1.1.0:新增 net8.0 / net9.0 / net10.0 三目标支持(同一套 API);其余行为与 1.0.0 一致。</PackageReleaseNotes>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnablePackageValidation>true</EnablePackageValidation>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!-- ================= 依赖(全部为最新稳定版) ================= -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" PrivateAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="AngleSharp" Version="1.10.5" />
    <PackageReference Include="ColorCode.WinUI" Version="2.0.15" />
    <!-- 公式渲染:CSharpMath 1.x 只有预发布版,这里用最新稳定版 0.5.1(配套 SkiaSharp 2.88.9) -->
    <PackageReference Include="CSharpMath.SkiaSharp" Version="0.5.1" />
    <PackageReference Include="SkiaSharp.Views.WinUI" Version="2.88.9" />
    <!-- CodeBlock 模板里的 ScrollViewerExtensions.HorizontalScrollBarMargin -->
    <PackageReference Include="CommunityToolkit.WinUI.Extensions" Version="8.2.251219" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- 图标只放根目录一份(PackageIcon 取根目录路径):先摘掉默认的 Content/None 再显式加入,避免 content/ 重复条目 -->
    <Content Remove="icon.png" />
    <None Remove="icon.png" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>



</Project>
